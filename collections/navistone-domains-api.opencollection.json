{
  "opencollection": "1.0.0",
  "info": {
    "name": "Zazmic Platform API Info Domains API",
    "version": "1.0.0"
  },
  "items": [
    {
      "info": {
        "name": "Domains",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get all domains",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{{baseUrl}}/api/domains",
            "auth": {
              "type": "apikey",
              "key": "X-API-Key",
              "value": "{{X-API-Key}}",
              "placement": "header"
            }
          },
          "docs": "Get all domains"
        },
        {
          "info": {
            "name": "Create a new domain with access key",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "{{baseUrl}}/api/domains",
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "apikey",
              "key": "X-API-Key",
              "value": "{{X-API-Key}}",
              "placement": "header"
            }
          },
          "docs": "Create a new domain with access key"
        },
        {
          "info": {
            "name": "Get a domain by ID",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{{baseUrl}}/api/domains/:id",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "Domain ID"
              }
            ],
            "auth": {
              "type": "apikey",
              "key": "X-API-Key",
              "value": "{{X-API-Key}}",
              "placement": "header"
            }
          },
          "docs": "Get a domain by ID"
        },
        {
          "info": {
            "name": "Update a domain",
            "type": "http"
          },
          "http": {
            "method": "PATCH",
            "url": "{{baseUrl}}/api/domains/:id",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "Domain ID"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "apikey",
              "key": "X-API-Key",
              "value": "{{X-API-Key}}",
              "placement": "header"
            }
          },
          "docs": "Update a domain"
        },
        {
          "info": {
            "name": "Soft delete a domain",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "{{baseUrl}}/api/domains/:id",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "Domain ID"
              }
            ],
            "auth": {
              "type": "apikey",
              "key": "X-API-Key",
              "value": "{{X-API-Key}}",
              "placement": "header"
            }
          },
          "docs": "Soft delete a domain"
        }
      ]
    }
  ],
  "bundled": true
}