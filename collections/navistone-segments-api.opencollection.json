{
  "opencollection": "1.0.0",
  "info": {
    "name": "Zazmic Platform API Info Segments API",
    "version": "1.0.0"
  },
  "items": [
    {
      "info": {
        "name": "Segments",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get all segments",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{{baseUrl}}/api/segments",
            "auth": {
              "type": "apikey",
              "key": "X-API-Key",
              "value": "{{X-API-Key}}",
              "placement": "header"
            }
          },
          "docs": "Get all segments"
        },
        {
          "info": {
            "name": "Create a new segment",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "{{baseUrl}}/api/segments",
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "apikey",
              "key": "X-API-Key",
              "value": "{{X-API-Key}}",
              "placement": "header"
            }
          },
          "docs": "Create a new segment"
        },
        {
          "info": {
            "name": "Get a segment by ID",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{{baseUrl}}/api/segments/:id",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "Segment ID"
              }
            ],
            "auth": {
              "type": "apikey",
              "key": "X-API-Key",
              "value": "{{X-API-Key}}",
              "placement": "header"
            }
          },
          "docs": "Get a segment by ID"
        },
        {
          "info": {
            "name": "Update a segment",
            "type": "http"
          },
          "http": {
            "method": "PATCH",
            "url": "{{baseUrl}}/api/segments/:id",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "Segment ID"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "apikey",
              "key": "X-API-Key",
              "value": "{{X-API-Key}}",
              "placement": "header"
            }
          },
          "docs": "Update a segment"
        },
        {
          "info": {
            "name": "Soft delete a segment",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "{{baseUrl}}/api/segments/:id",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "Segment ID"
              }
            ],
            "auth": {
              "type": "apikey",
              "key": "X-API-Key",
              "value": "{{X-API-Key}}",
              "placement": "header"
            }
          },
          "docs": "Soft delete a segment"
        }
      ]
    }
  ],
  "bundled": true
}